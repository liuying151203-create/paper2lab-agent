# Runtime
P2GL_ENV=development
P2GL_API_HOST=127.0.0.1
P2GL_API_PORT=8000

# Local storage
P2GL_DATA_DIR=data
P2GL_SQLITE_PATH=data/metadata.sqlite3

# Model provider settings
# Do not commit real API keys. Copy this file to .env for local use.
P2GL_MODEL_PROVIDER=
P2GL_MODEL_NAME=
P2GL_EMBEDDING_MODEL=
P2GL_API_KEY=
