# Runtime
P2GL_ENV=development
P2GL_API_HOST=127.0.0.1
P2GL_API_PORT=8000

# Local storage
P2GL_DATA_DIR=data
P2GL_SQLITE_PATH=data/metadata.sqlite3

# Model provider settings
# Do not commit real API keys. Copy this file to .env for local use.
P2GL_MODEL_PROVIDER=
P2GL_MODEL_NAME=
P2GL_MODEL_BASE_URL=
P2GL_EMBEDDING_MODEL=
P2GL_API_KEY=

# Evidence retrieval
# local: use persisted chunks in this project
# graphrag: call an external GraphRAG service, falling back to local chunks
P2GL_EVIDENCE_PROVIDER=local
P2GL_GRAPHRAG_BASE_URL=
P2GL_GRAPHRAG_ENDPOINT=/qa/ask
P2GL_GRAPHRAG_TIMEOUT_SECONDS=30
